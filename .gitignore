# ---- 环境与缓存 ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 运行产物：内含真实简历原文与个人信息，绝不入库 ----
out/
local/*
!local/resumes.json.example
!local/*.example
*.log

# ---- 密钥与本地配置 ----
.env
*.env
secrets/
!*.env.example

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# exe 构建产物与打包中间文件
build/
dist/
*.spec

# ---- 校准时的配置版本备份（内容已存 calibration 表，避免仓库噪音）----
config/history/
config/*.bak-*
config/*.bak

# ---- 实验产物：模型权重不入库（按 experiments/*/README.md 重下）----
experiments/*/model/
experiments/*/.venv/
