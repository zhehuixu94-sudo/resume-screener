# 环境变量样例 —— 复制成 .env 后填值；.env 已被 .gitignore 排除，绝不入库。
# 由赫尔墨斯补入（对应 PROJECT-ALIGN-20260926「完整项目」缺口②）。
# 说明：代码只从环境变量读密钥（app/llm/client.py），仓库里没有任何凭据。

# ---- LLM 平台（硅基流动，OpenAI 兼容 HTTP）----
SILICONFLOW_API_KEY=

# 可选：本机密钥文件路径（开发期用；内容形如 SILICONFLOW_API_KEY=sk-xxx）
# 生产请留空，只走上面的环境变量。
# SILICONFLOW_ENV_FILE=

# ---- 数据库（PostgreSQL + pgvector 容器 resume_pg）----
# 二选一，两种写法都可以；PG_DSN 优先。
# 1) 整串 DSN：
# PG_DSN=postgresql://resume_app:CHANGE_ME@127.0.0.1:5433/resume_screener
# 2) 分项：**下面填的是部署值**；代码默认值见 app/store/db.py（host 127.0.0.1 / port **5432** / user resume_app / db resume_screener）。
#    两者不同是有原因的：容器把宿主 5433 映射到容器内 5432，所以接容器必须用 5433（run.bat 会自动设 PGPORT=5433）；
#    不设 PGPORT 直接跑 python 会连 5432 而连不上。
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=resume_app
PGPASSWORD=
PGDATABASE=resume_screener

# ---- 可选：模型覆盖（不填走代码默认）----
# RESUME_MODEL=Qwen/Qwen3.5-122B-A10B
# 降本档：Qwen/Qwen3.5-35B-A3B
