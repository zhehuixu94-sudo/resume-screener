{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume-screener/schemas/llm/parse_output.schema.json",
  "title": "LlmParseOutput",
  "description": "喂给模型/校验模型输出用；改了模型就重新导出。",
  "$defs": {
    "LlmAchievement": {
      "description": "量化成就：**与能力项无关**的一条职责/产出原句，必须保留数字、时间、成果词。\n\n为什么单开一条通道：能力项抽取是\"为某个能力找一句 ≤60 字连续片段\"，会把\n\"发现并协助处理3处安全隐患…；故障响应缩短至30分钟内；录入数据3000余条\"这种\n分号拼接的量化长句切碎，只留下不含数字的短句（实测真实简历抽出的 7 条证据片段里\n**一个数字都没有**）。而\"具体性\"信号完全依赖片段里有没有数字 → 输入被掏空。",
      "properties": {
        "text": {
          "description": "原文**连续**片段，≤120 字，必须原样保留其中的数字/比例/时长",
          "minLength": 4,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "default": "产出",
          "enum": [
            "职责",
            "产出",
            "量化"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "LlmAchievement",
      "type": "object"
    },
    "LlmParseBlock": {
      "properties": {
        "section": {
          "description": "段落类型：教育背景/项目经历/实习经历/技能/…",
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "period": {
          "default": "",
          "title": "Period",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LlmParseItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "section",
        "title",
        "items"
      ],
      "title": "LlmParseBlock",
      "type": "object"
    },
    "LlmParseItem": {
      "properties": {
        "capability": {
          "description": "能力项名称",
          "minLength": 2,
          "title": "Capability",
          "type": "string"
        },
        "evidence": {
          "description": "简历原文连续片段，≤60 字，不得改写/拼接",
          "maxLength": 80,
          "minLength": 4,
          "title": "Evidence",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "evidence"
      ],
      "title": "LlmParseItem",
      "type": "object"
    },
    "LlmParseQuality": {
      "properties": {
        "sections_found": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sections Found",
          "type": "array"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "sections_found"
      ],
      "title": "LlmParseQuality",
      "type": "object"
    }
  },
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/LlmParseBlock"
      },
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "parse_quality": {
      "$ref": "#/$defs/LlmParseQuality"
    },
    "achievements": {
      "items": {
        "$ref": "#/$defs/LlmAchievement"
      },
      "title": "Achievements",
      "type": "array"
    }
  },
  "required": [
    "blocks",
    "parse_quality"
  ],
  "type": "object",
  "x-contract-version": "1.0.0",
  "x-model": "app.contracts.llm_outputs.LlmParseOutput"
}
