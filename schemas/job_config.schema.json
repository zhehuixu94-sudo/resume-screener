{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume-screener/schemas/job_config.schema.json",
  "title": "JobConfig",
  "description": "HR 侧唯一配置入口：硬门槛 + 维度锚点 + 加分项关键词 + 达标线/三段带 + 锚点标定。",
  "$defs": {
    "BonusItem": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "number"
        },
        "keywords": {
          "description": "必须显式声明，靠名称模糊匹配会漏（实测）",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Keywords",
          "type": "array"
        }
      },
      "required": [
        "name",
        "points",
        "keywords"
      ],
      "title": "BonusItem",
      "type": "object"
    },
    "Calibration": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "uncalibrated",
          "enum": [
            "uncalibrated",
            "calibrated"
          ],
          "title": "Status",
          "type": "string"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/CalibrationAnchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "good_group_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Good Group Min"
        },
        "calibrated_at": {
          "default": "",
          "title": "Calibrated At",
          "type": "string"
        },
        "notes": {
          "default": "",
          "description": "标定诊断：两组分数是否分得开、样本是否够数、缺哪些硬证据",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "Calibration",
      "type": "object"
    },
    "CalibrationAnchor": {
      "additionalProperties": false,
      "description": "HR 给的锚点样本：合格 3~5 份 + 不合格 2~3 份 → 系统算分 → 达标线 = 合格组下限。",
      "properties": {
        "label": {
          "enum": [
            "合格",
            "不合格"
          ],
          "title": "Label",
          "type": "string"
        },
        "resume_ref": {
          "description": "简历标识：文件名 / resume_id",
          "minLength": 1,
          "title": "Resume Ref",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "label",
        "resume_ref"
      ],
      "title": "CalibrationAnchor",
      "type": "object"
    },
    "Dimension": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Weight",
          "type": "number"
        },
        "anchors": {
          "$ref": "#/$defs/DimensionAnchors"
        },
        "keywords": {
          "description": "兜底归类用；空 = 不参与兜底",
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "weight",
        "anchors"
      ],
      "title": "Dimension",
      "type": "object"
    },
    "DimensionAnchors": {
      "additionalProperties": false,
      "description": "三档锚点 = 相对比较的标尺。每档写人话示例，别写抽象形容词。\n\n硬约束只有\"非空且三档不完全相同\"；\"这段锚点够不够当尺子\"交给 anchor_lint() 出警告——\n契约负责不让人写出非法配置，不负责替 HR 判定锚点写得好不好。",
      "properties": {
        "合格": {
          "minLength": 2,
          "title": "合格",
          "type": "string"
        },
        "边缘": {
          "minLength": 2,
          "title": "边缘",
          "type": "string"
        },
        "不达标": {
          "minLength": 2,
          "title": "不达标",
          "type": "string"
        }
      },
      "required": [
        "合格",
        "边缘",
        "不达标"
      ],
      "title": "DimensionAnchors",
      "type": "object"
    },
    "HardFilter": {
      "additionalProperties": false,
      "description": "硬门槛（一票否决）。\n\n判定口径：**先规则后模型**。配了 keywords_pass / keywords_fail 的门槛由规则层在简历全文里判定，\n模型不再有机会误报\"哪条门槛被触发\"（实测模型会把明明写了的本科判成\"未提及\"）；\n没配关键词的门槛退回模型判定（旧行为），并且只认模型能定位到具体门槛的情形。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rule": {
          "description": "人话规则，如「本科及以上」，会原样进 prompt",
          "minLength": 2,
          "title": "Rule",
          "type": "string"
        },
        "veto": {
          "default": true,
          "title": "Veto",
          "type": "boolean"
        },
        "require_evidence": {
          "default": true,
          "description": "要求系统必须找到证据才判触发",
          "title": "Require Evidence",
          "type": "boolean"
        },
        "keywords": {
          "description": "可选：辅助定位与该门槛相关的原文（正负关键词的并集）",
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "keywords_pass": {
          "description": "命中任一 → 判通过",
          "items": {
            "type": "string"
          },
          "title": "Keywords Pass",
          "type": "array"
        },
        "keywords_fail": {
          "description": "命中任一且未命中 pass 关键词 → 判不通过",
          "items": {
            "type": "string"
          },
          "title": "Keywords Fail",
          "type": "array"
        },
        "unknown_policy": {
          "default": "manual_review",
          "description": "两边关键词都没命中时的处置：转人工（默认，宁可多看）或不通过",
          "enum": [
            "manual_review",
            "fail"
          ],
          "title": "Unknown Policy",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "rule"
      ],
      "title": "HardFilter",
      "type": "object"
    },
    "Scoring": {
      "additionalProperties": false,
      "properties": {
        "pass_line": {
          "description": "达标线",
          "maximum": 200,
          "minimum": 0,
          "title": "Pass Line",
          "type": "number"
        },
        "pass_line_source": {
          "default": "manual_default",
          "enum": [
            "manual_default",
            "anchor_calibrated"
          ],
          "title": "Pass Line Source",
          "type": "string"
        },
        "band_width": {
          "default": 5.0,
          "description": "三段带：≥线+band 自动达标 / ±band 转人工 / <线−band 自动淘汰",
          "minimum": 0,
          "title": "Band Width",
          "type": "number"
        },
        "dimension_aggregation": {
          "default": "best",
          "enum": [
            "best",
            "top2_mean"
          ],
          "title": "Dimension Aggregation",
          "type": "string"
        },
        "labeling_repeats": {
          "default": 1,
          "description": "标注阶段重复次数：>1 时取中位数（相关性×难度）+ 维度多数投票，用来压标注噪声。实测：单次跑同一份简历总分极差 10.0，3 次取中位数后 0.0（成本是标注多调 2 次）",
          "maximum": 9,
          "minimum": 1,
          "title": "Labeling Repeats",
          "type": "integer"
        },
        "fallback_keyword_mapping": {
          "default": true,
          "description": "模型没给维度时是否用维度 keywords 兜底归类",
          "title": "Fallback Keyword Mapping",
          "type": "boolean"
        },
        "confidence_floor": {
          "default": 0.6,
          "description": "低于此置信度不自动淘汰",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence Floor",
          "type": "number"
        }
      },
      "required": [
        "pass_line"
      ],
      "title": "Scoring",
      "type": "object"
    },
    "VetoOverride": {
      "additionalProperties": false,
      "description": "硬门槛豁免：满足条件时，把\"自动淘汰\"降级成\"转人工\"。\n\n存在的理由：硬门槛是筛人的，但\"综合达标\"才是真实标准 —— 一个四级没过、ACM 拿金牌的候选人\n不该被一条证书直接刷掉。豁免只降级、不升级：绝不允许因为豁免而自动达标。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "when_dimension": {
          "description": "看哪个维度",
          "minLength": 1,
          "title": "When Dimension",
          "type": "string"
        },
        "min_points": {
          "description": "该维度得分 ≥ 这个值才豁免",
          "exclusiveMinimum": 0,
          "title": "Min Points",
          "type": "number"
        },
        "applies_to": {
          "description": "豁免哪些门槛 id；空 = 所有硬门槛",
          "items": {
            "type": "string"
          },
          "title": "Applies To",
          "type": "array"
        },
        "require_bonus": {
          "description": "还必须命中的加分项名称（如『省级以上竞赛获奖』）",
          "items": {
            "type": "string"
          },
          "title": "Require Bonus",
          "type": "array"
        },
        "reason": {
          "minLength": 2,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "when_dimension",
        "min_points",
        "reason"
      ],
      "title": "VetoOverride",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Job Id",
      "type": "string"
    },
    "config_version": {
      "default": "1",
      "description": "配置改动递增；评分行记它才能复现历史分数",
      "minLength": 1,
      "title": "Config Version",
      "type": "string"
    },
    "company_id": {
      "default": "local",
      "description": "多租户预留：不做 RLS，但每条数据都带它",
      "title": "Company Id",
      "type": "string"
    },
    "job_title": {
      "minLength": 1,
      "title": "Job Title",
      "type": "string"
    },
    "jd": {
      "minLength": 20,
      "title": "Jd",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/Dimension"
      },
      "minItems": 1,
      "title": "Dimensions",
      "type": "array"
    },
    "hard_filters": {
      "items": {
        "$ref": "#/$defs/HardFilter"
      },
      "title": "Hard Filters",
      "type": "array"
    },
    "bonus": {
      "items": {
        "$ref": "#/$defs/BonusItem"
      },
      "title": "Bonus",
      "type": "array"
    },
    "scoring": {
      "$ref": "#/$defs/Scoring"
    },
    "calibration": {
      "$ref": "#/$defs/Calibration"
    },
    "overrides": {
      "description": "硬门槛豁免规则：综合实力足够强时不自动淘汰，转人工",
      "items": {
        "$ref": "#/$defs/VetoOverride"
      },
      "title": "Overrides",
      "type": "array"
    },
    "interview_focus": {
      "default": "",
      "title": "Interview Focus",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "job_title",
    "jd",
    "dimensions",
    "scoring"
  ],
  "type": "object",
  "x-contract-version": "1.0.0",
  "x-model": "app.contracts.job_config.JobConfig"
}
